# Select one LiteLLM-compatible provider and set its API key.
LLM_MODEL=provider/model-name
OPENROUTER_API_KEY=replace_me

# Alternatives include OPENAI_API_KEY, ANTHROPIC_API_KEY, and GEMINI_API_KEY.

# Auto Nexus Studio authentication. Local mode is restricted to loopback.
AUTONEXUS_AUTH_MODE=local

# For a shared/non-loopback Studio, install AutoNexus[auth], change the mode to
# firebase, enable Firebase Email/Password authentication, and fill these public
# web-app values. The Admin SDK obtains server credentials from
# GOOGLE_APPLICATION_CREDENTIALS or Application Default Credentials.
# AUTONEXUS_AUTH_MODE=firebase
# AUTONEXUS_FIREBASE_API_KEY=replace_me
# AUTONEXUS_FIREBASE_PROJECT_ID=replace_me
# AUTONEXUS_FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
# AUTONEXUS_FIREBASE_APP_ID=replace_me

# Remote Firebase users are upload-only by default. Enabling local paths gives
# authenticated users access to datasets already present on the server.
# AUTONEXUS_ALLOW_REMOTE_LOCAL_PATHS=false

# Optional run storage override. The default is the user's application-data dir.
# AUTONEXUS_WEB_WORKSPACE=C:\AutoNexus\studio-runs
